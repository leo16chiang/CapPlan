# Copy to .env and fill in. .env is git-ignored; this file is not, so it must
# never contain a real credential.
#
# CapPlan loads .env then .env.local at startup. Anything already set in the
# real environment wins, so a scheduled batch or container can inject
# credentials normally and these act as a developer convenience.

# --- Db2 connection -------------------------------------------------------
CAPPLAN_DB2_HOST=your_host
CAPPLAN_DB2_PORT=50000
CAPPLAN_DB2_DATABASE=your_db
CAPPLAN_DB2_USER=your_user

# Either a literal password...
CAPPLAN_DB2_PASSWORD=

# ...or a command whose stdout is the password. Preferred: the value never
# sits in a file or a shell variable. The command runs at connection time.
# CAPPLAN_DB2_PASSWORD_CMD=vault read -field=password secret/db2/capplan

# ODBC driver name exactly as registered on this machine. Check with:
#   odbcinst -q -d          (Linux/macOS)
#   ODBC Data Source Administrator -> Drivers  (Windows)
CAPPLAN_DB2_DRIVER={IBM DB2 ODBC DRIVER}

# Alternatively, one complete ODBC string, overriding everything above.
# CAPPLAN_DB2_DSN=

# --- Optional -------------------------------------------------------------
# CAPPLAN_CONFIG=config/capplan.yaml
# CAPPLAN_LOG_LEVEL=INFO
