# Credentials. .env.example is committed; .env is never.
.env
.env.local
.env.*
!.env.example

__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/
build/
dist/

# Data and artefacts are environment-local; only the manifest schema is versioned.
data_lake/
artefacts/*
!artefacts/.gitkeep
*.parquet
*.duckdb
*.duckdb.wal
